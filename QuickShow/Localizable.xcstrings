          }
        }
      }
    },
    "Chat Completions 兼容大多数 OpenAI 兼容端点（中转 / Ollama / vLLM 等）；Responses 为 OpenAI 官方新协议，仅官方端点支持。选择 Responses 时 Base URL 填官方地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Completions works with most OpenAI-compatible endpoints (relays / Ollama / vLLM etc.); Responses is OpenAI's new official protocol, supported only on official endpoints. When using Responses, enter the official address as Base URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Completions 兼容大多数 OpenAI 兼容端点（中转 / Ollama / vLLM 等）；Responses 为 OpenAI 官方新协议，仅官方端点支持。选择 Responses 时 Base URL 填官方地址。"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "en": {
