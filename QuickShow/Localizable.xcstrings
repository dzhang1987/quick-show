        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default \"Auto\" adapts precisely to your display resolution: content wraps naturally, keeping high information density with compact layout and no empty gaps; standard, compact or large sizes can also be chosen manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
