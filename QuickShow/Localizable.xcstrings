        }
      }
    },
    "例如 api.openai.com/v1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. api.openai.com/v1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如 api.openai.com/v1"
          }
        }
      }
    },
    "OpenAI 兼容端点的根地址，程序会自动用所选协议拼接请求路径。官方端点填 https://api.openai.com/v1；本地 Ollama / vLLM 填 http://localhost:端口/v1。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root address of an OpenAI-compatible endpoint; the app appends request paths based on the selected protocol. Official endpoints: https://api.openai.com/v1; local Ollama / vLLM: http://localhost:port/v1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 兼容端点的根地址，程序会自动用所选协议拼接请求路径。官方端点填 https://api.openai.com/v1；本地 Ollama / vLLM 填 http://localhost:端口/v1。"
          }
        }
      }
    },
