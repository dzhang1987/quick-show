          }
        }
      }
    },
    "全局双击 ⌥⌥ 随时唤出 / 关闭 AI 对话窗（热键可在「快捷键设置」中更改）；主面板激活时按 I 键亦可进入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap ⌥⌥ globally to summon / dismiss the AI window anytime (hotkey configurable in Shortcuts Settings); press I while the main panel is active as well."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局双击 ⌥⌥ 随时唤出 / 关闭 AI 对话窗（热键可在「快捷键设置」中更改）；主面板激活时按 I 键亦可进入。"
          }
        }
      }
    },
